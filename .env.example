# Google Gemini API Key for Gemini Flash Lite (Free tier: 15 RPM, 250K TPM, 500 RPD)
# Obtain your free key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model Configuration (1st Priority: gemini-3.5-flash-lite, with automatic fallbacks)
GEMINI_MODEL=gemini-3.5-flash-lite
TEMPERATURE=0.0

# Deployment Configuration
PORT=5000
HOST=0.0.0.0
